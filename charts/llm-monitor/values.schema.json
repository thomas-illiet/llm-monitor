{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "secretName": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["enabled", "create", "parentRefs", "hostnames", "gatewayClassName", "listeners"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "group": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "additionalProperties": false
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gatewayClassName": {
          "type": "string"
        },
        "listeners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "protocol", "port"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "hostname": {
                "type": "string"
              },
              "protocol": {
                "type": "string",
                "enum": ["HTTP", "HTTPS"]
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "tls": {
                "type": "object"
              },
              "allowedRoutes": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "create": {
                "const": true
              }
            },
            "required": ["create"]
          },
          "then": {
            "properties": {
              "gatewayClassName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "config": {
      "type": "object",
      "required": ["postgres", "target"],
      "properties": {
        "postgres": {
          "type": "object",
          "required": ["dsn"],
          "properties": {
            "dsn": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "target": {
          "type": "object",
          "required": ["base_url"],
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1
            },
            "api_key": {
              "type": "string"
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "client_secret": {
              "type": "string"
            },
            "mtls": {
              "type": "object",
              "properties": {
                "cert_file": {
                  "type": "string"
                },
                "cert_file_data": {
                  "type": "string"
                },
                "key_file": {
                  "type": "string"
                },
                "key_file_data": {
                  "type": "string"
                }
              }
            }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "password": {
              "type": "string"
            }
          }
        },
        "mcp": {
          "type": "object",
          "properties": {
            "bearer_token": {
              "type": "string"
            }
          }
        }
      }
    },
    "certFiles": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "embeddingFixture": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "content": {
          "type": "string"
        }
      }
    }
  }
}
